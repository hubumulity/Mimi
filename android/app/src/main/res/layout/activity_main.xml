<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/brand_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/mimi_brand"
            android:contentDescription="@string/brand_description" />
        <LinearLayout
            android:id="@+id/home_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical" />
    </LinearLayout>
    <RadioGroup
        android:id="@+id/settings_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/mimi_surface"
        android:padding="4dp"
        android:orientation="horizontal"
        android:checkedButton="@id/tab_caption"
        android:layout_marginBottom="12dp">
        <RadioButton
            android:id="@+id/tab_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/mimi_segment"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@string/navigation_captions"
            android:textColor="@color/mimi_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <RadioButton
            android:id="@+id/tab_service"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingVertical="8dp"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/mimi_segment"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="@string/navigation_services"
            android:textColor="@color/mimi_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <RadioButton
            android:id="@+id/tab_general"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:padding="8dp"
            android:button="@null"
            android:background="@drawable/mimi_segment"
            android:gravity="center"
            android:text="@string/navigation_more"
            android:textColor="@color/mimi_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp" />
    </RadioGroup>
    <app.yuxino.mimi.android.CaptionWorkspace
        android:id="@+id/caption_workspace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <app.yuxino.mimi.android.ControlScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false">
            <app.yuxino.mimi.android.SubtitlePreviewView
                android:id="@+id/subtitle_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </app.yuxino.mimi.android.ControlScrollView>
    <app.yuxino.mimi.android.ControlScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:id="@+id/settings_scroll">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:id="@+id/home_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/status_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:textSize="16sp"
                    android:textColor="@color/mimi_muted"
                    android:lineSpacingExtra="3dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:id="@+id/source_language_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:minHeight="64dp"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/mimi_surface"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_source"
                            android:textAppearance="@style/TextAppearance.Mimi.Label" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/source_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:drawableEndCompat="@drawable/ic_expand"
                            android:layout_marginTop="6dp"
                            android:text="@string/lang_auto"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/mimi_text" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_arrow"
                        android:importantForAccessibility="no"
                        app:tint="@color/mimi_muted" />
                    <LinearLayout
                        android:id="@+id/target_language_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:minHeight="64dp"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/mimi_surface"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_target"
                            android:textAppearance="@style/TextAppearance.Mimi.Label" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/target_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:drawableEndCompat="@drawable/ic_expand"
                            android:layout_marginTop="6dp"
                            android:text="@string/lang_zh"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/mimi_text" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/service_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:id="@+id/provider_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no" />
                    <ImageView
                        android:id="@+id/translation_provider_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="fitCenter"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_service"
                            android:textAppearance="@style/TextAppearance.Mimi.Label" />
                        <TextView
                            android:id="@+id/provider_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="14sp"
                            android:textColor="@color/mimi_text" />
                        <TextView
                            android:id="@+id/model_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="16sp"
                            android:textColor="@color/mimi_text"
                            android:visibility="gone" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/mimi_muted" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/service_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:id="@+id/general_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/interface_language"
                    android:text="@string/settings_interface_language"
                    android:textSize="16sp"
                    android:textColor="@color/mimi_text" />
                <Spinner
                    android:id="@+id/interface_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/settings_field"
                    android:popupBackground="@color/mimi_bg"
                    android:spinnerMode="dropdown" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/settings_advanced"
                    android:textSize="16sp"
                    android:textColor="@color/mimi_text" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy_capture_diagnostics"
                    style="@style/Widget.Mimi.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/copy_capture_diagnostics"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/first_run_guide"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_open"
                    android:textAllCaps="false"
                    android:layout_marginTop="24dp" />
            </LinearLayout>
        </LinearLayout>
    </app.yuxino.mimi.android.ControlScrollView>
    </app.yuxino.mimi.android.CaptionWorkspace>
    <app.yuxino.mimi.android.SessionControlsLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_setup_status"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mimi_text"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/status_help"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintHorizontal_bias="0" />
            <ImageButton
                android:id="@+id/status_help"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:layout_constraintStart_toEndOf="@id/status"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_stop"
            style="@style/Widget.Mimi.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/start_capture"
            app:icon="@drawable/ic_play"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconGravity="textStart" />
    </app.yuxino.mimi.android.SessionControlsLayout>
</LinearLayout>
